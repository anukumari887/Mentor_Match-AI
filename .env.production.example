NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ==============================================================================
# Database Credentials (Single Unified Source)
# Generate random 24-byte hex passwords using:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use ONLY alphanumeric/hex characters. Do NOT use special characters (@, :, /, #, ?)
# and do NOT wrap passwords in quotes or leave spaces around the '=' sign.
# ==============================================================================
MONGO_USER=admin
MONGO_PASSWORD=9f3b8c2d1e0a4f5b6c7d8e9f0123456789abcdef01234567
REDIS_PASSWORD=a1b2c3d4e5f60718293a4b5c6d7e8f901234567890abcdef

# Optional override: only set if using an external managed database (e.g. Atlas / ElastiCache)
# MONGO_URI=mongodb://admin:9f3b8c2d1e0a4f5b6c7d8e9f0123456789abcdef01234567@mongo:27017/mentormatch?authSource=admin
# REDIS_URL=redis://:a1b2c3d4e5f60718293a4b5c6d7e8f901234567890abcdef@redis:6379

ML_SERVICE_URL=http://ml-service:8000
ML_TIMEOUT_MS=2000

JWT_SECRET=replace_with_a_secure_random_production_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true
CORS_ORIGIN=https://mentormatch.example.com

# ==============================================================================
# Admin Account Bootstrap
# Used ONLY when the first admin is created on an empty database.
# Changing ADMIN_PASSWORD here later will NOT update an existing admin.
# To update an existing admin's password, run:
# docker compose -f docker-compose.prod.yml exec backend npm run admin:reset
# To verify credentials, run:
# docker compose -f docker-compose.prod.yml exec backend npm run admin:check
# ==============================================================================
ADMIN_EMAIL=admins@matchmentor.ai
ADMIN_PASSWORD=mentor998

PAYMENT_MODE=razorpay
PLATFORM_FEE_PERCENT=15
SLOT_LOCK_MINUTES=10
MIN_BOOKING_LEAD_HOURS=2
FREE_CANCEL_HOURS=24
RAZORPAY_KEY_ID=rzp_live_production_key_id
RAZORPAY_KEY_SECRET=production_secret
RAZORPAY_WEBHOOK_SECRET=production_webhook_secret

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=production_smtp_password
EMAIL_FROM=Mentor-Match <support@mentormatch.example.com>

STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

METRICS_TOKEN=production_prometheus_token
CHAT_VALIDITY_DAYS=7
CHAT_EMAIL_THROTTLE_MINUTES=10

# demo = no real emails and no verification; set to live and fill the SMTP settings for real users
EMAIL_MODE=demo
EMAIL_VERIFICATION_REQUIRED=true

VITE_API_URL=https://api.mentormatch.example.com
PUBLIC_APP_URL=https://mentormatch.example.com
