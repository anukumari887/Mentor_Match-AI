{
  "name": "mentor-match-backend",
  "version": "1.0.0",
  "description": "Backend API for Mentor-Match AI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon -L src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "smoke:auth": "node scripts/smokeAuth.js",
    "smoke:discovery": "node scripts/smokeDiscovery.js",
    "smoke:booking": "node scripts/smokeBooking.js",
    "smoke:payments": "node scripts/smokePayments.js",
    "smoke:recommendations": "node scripts/smokeRecommendations.js",
    "smoke:reviews": "node scripts/smokeReviews.js",
    "smoke:video": "node scripts/smokeVideo.js",
    "seed": "node scripts/seed.js",
    "seed:video-demo": "node scripts/seed-video-demo.js",
    "admin:check": "node scripts/adminCheck.js",
    "admin:reset": "node scripts/adminReset.js",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "axios": "1.7.9",
    "bcryptjs": "3.0.2",
    "cookie": "0.7.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.0.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "ioredis": "5.5.0",
    "jsonwebtoken": "9.0.2",
    "luxon": "3.5.0",
    "mongoose": "8.10.1",
    "nodemailer": "6.10.0",
    "pino": "9.6.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "4.2.0",
    "razorpay": "2.9.5",
    "socket.io": "4.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "nodemon": "3.1.9",
    "pino-pretty": "13.0.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
